# ─── Binance (API Key con permisos: lectura + C2C. SIN retiros. Restringida por IP) ───
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://api.binance.com
# Fiat de las órdenes a procesar
BINANCE_FIAT=VES

# ─── Telegram ───
# Un token por bot para que en el grupo aparezcan como bots distintos.
# Si dejas alguno vacío se usa TELEGRAM_TOKEN_HUB.
TELEGRAM_TOKEN_HUB=
TELEGRAM_TOKEN_BINANCE=
TELEGRAM_TOKEN_BNC=
TELEGRAM_TOKEN_COMPROBANTE=
# ID del grupo (negativo, ej. -1001234567890)
TELEGRAM_CHAT_ID=
# Grupo EXCLUSIVO de fallos: todo error, rechazo o revisión manual se envía SOLO aquí.
# Agrega a este grupo el bot de fallos y también el bot HUB (para usar los comandos desde aquí).
TELEGRAM_CHAT_ID_FALLOS=
# Bot que publica en el grupo de fallos (vacío = usa TELEGRAM_TOKEN_HUB)
TELEGRAM_TOKEN_FALLOS=
# Tu user_id de Telegram: solo tú puedes aprobar pagos o enviar OTP
TELEGRAM_ADMIN_ID=

# ─── BNC ───
BNC_URL=https://personas.bncenlinea.com
BNC_USUARIO=
BNC_CLAVE=
# Respuestas a preguntas de seguridad en formato "pregunta1=respuesta1;pregunta2=respuesta2"
BNC_PREGUNTAS=
# Cuenta origen (20 dígitos) desde la que se paga
BNC_CUENTA_ORIGEN=
# true = abre el navegador visible (recomendado mientras se mapean pantallas)
BNC_HEADFUL=true

# ─── Correo donde llegan los códigos de BNC (IMAP) ───
# Gmail: activa la verificación en 2 pasos y crea una "contraseña de aplicación"
# (Cuenta de Google → Seguridad → Contraseñas de aplicaciones). NO uses tu clave normal.
CORREO_IMAP=imap.gmail.com
CORREO_USUARIO=
CORREO_CLAVE=
# Remitente de los correos de BNC (dirección o parte de ella, ej. bnc.com.ve)
CORREO_REMITENTE=
# Opcional: expresión regular si el código no se detecta solo. El grupo 1 es el código.
# Ejemplo: clave[^0-9]*(\d{6})
CORREO_PATRON=
CORREO_CARPETA=INBOX

# ─── Seguridad ───
# SIMULACION=true: llena todo en BNC pero NO confirma el pago ni marca pagado en Binance
SIMULACION=true
# Monto máximo por orden (Bs). Por encima => se rechaza
MONTO_MAX_ORDEN=50000
# Monto máximo diario (Bs)
MONTO_MAX_DIA=500000
# Por encima de este monto se pide aprobación manual en Telegram (0 = aprobar todo manualmente)
UMBRAL_APROBACION=0
# Similitud mínima (0-1) entre nombre KYC de Binance y titular de la cuenta destino
SIMILITUD_NOMBRE_MIN=0.6

# ─── Panel de control ───
# Clave para abrir el panel en el navegador (vacío = sin clave; solo se abre desde esta computadora)
PANEL_CLAVE=
PANEL_PUERTO=8765

DB_PATH=data/bnc_bot.sqlite3
POLL_SEGUNDOS=10
